---
import Badge from './Badge.astro';
import { trustVerdict } from '../utils/badgeStyles';

interface Props {
  provenance: string;
  vendor: string | null;
  reviewStatus: string;
  reviewedAt: string | null;
  freshness: string | null;
  upstreamChangedAt: string | null;
  upstreamFetchedAt: string | null;
  license: string;
}

const { provenance, vendor, reviewStatus, reviewedAt, freshness, upstreamChangedAt, upstreamFetchedAt, license } = Astro.props;

const isDrifted = freshness === 'drifted';
const verdict = trustVerdict(reviewStatus, freshness, provenance);
---

<details class="trust-summary group">
  <summary class={`cursor-pointer inline-flex items-center gap-1 px-2 py-0.5 rounded text-xs font-medium font-mono ${verdict.style}`}>
    {verdict.warn ? (
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    ) : (
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    )}
    {verdict.label}
    <span class="text-[9px] text-current/60 group-open:hidden">(details)</span>
  </summary>
  <div class="mt-2 flex flex-wrap gap-2 items-center">
    <Badge type="provenance" value={provenance} vendor={vendor} />
    <Badge type="epistemic" value={reviewStatus} provenance={provenance} reviewedAt={reviewedAt} />
    <Badge type="freshness" value={freshness} date={isDrifted ? upstreamChangedAt : upstreamFetchedAt} />
    <Badge type="license" value={license} />
  </div>
</details>
