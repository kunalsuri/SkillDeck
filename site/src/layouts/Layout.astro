---
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

// Single source of truth for the site chrome (head, header/nav, footer)
// shared by every page. Before this existed, each page hand-duplicated
// this markup and the copies had already drifted - two pages ended up
// with a different header/footer max-width, background opacity, and
// Google Fonts weight set than the rest, which is what made the nav bar
// visibly resize/reflow when navigating between them.
export type NavKey = 'catalog' | 'sdlc' | 'general-skills' | 'similarity' | 'doctor' | 'faq' | 'about';

interface Props {
  title: string;
  description: string;
  active?: NavKey;
  mainClass: string;
}

const { title, description, active, mainClass } = Astro.props;

const NAV_ITEMS: { key: NavKey; href: string; label: string }[] = [
  { key: 'catalog', href: '/', label: 'Skill Catalog' },
  { key: 'general-skills', href: '/general-skills', label: 'General Skills' },
  { key: 'sdlc', href: '/sdlc', label: 'SDLC' },
  { key: 'similarity', href: '/similarity', label: 'Similarity' },
  { key: 'doctor', href: '/doctor', label: 'Skill Doctor' },
  { key: 'faq', href: '/faq', label: 'FAQ' },
  { key: 'about', href: '/about', label: 'About' },
];

const ACTIVE_CLASS = 'text-zinc-900 dark:text-zinc-100 hover:text-blue-600 dark:hover:text-blue-400';
const INACTIVE_CLASS = 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200';
---

<!doctype html>
<html lang="en">
  <head>
    <ThemeInit />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@300;400;500;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-zinc-50 text-zinc-900 dark:bg-zinc-950 dark:text-zinc-100 transition-colors duration-200 min-h-screen flex flex-col">
    {/* Skip link: first focusable element on every page, invisible until
        focused, so keyboard users can bypass the 7-item nav instead of
        tabbing through it on every single page load. */}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:rounded focus:bg-accent focus:text-white focus:text-sm focus:font-mono focus:font-semibold focus:shadow-lg"
    >
      Skip to content
    </a>

    {/* Header */}
    <header class="border-b border-zinc-200 dark:border-zinc-800 bg-white/80 dark:bg-zinc-900/80 backdrop-blur sticky top-0 z-10">
      <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="flex items-center gap-2">
          <span class="text-lg font-mono font-bold tracking-tight text-zinc-900 dark:text-white flex items-center">
            Skill<span class="text-blue-600 dark:text-blue-500 font-sans">Deck</span>
          </span>
          <span class="text-[10px] font-mono border border-zinc-300 dark:border-zinc-700 px-1 rounded text-zinc-500">v0.1.0</span>
        </a>
        <div class="flex items-center gap-4">
          <nav class="hidden md:flex items-center gap-6 text-sm font-mono font-medium">
            {NAV_ITEMS.map((item) => (
              <a href={item.href} class={active === item.key ? ACTIVE_CLASS : INACTIVE_CLASS}>{item.label}</a>
            ))}
          </nav>
          <ThemeToggle />
          <button
            id="mobile-nav-toggle"
            type="button"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="mobile-nav"
            class="md:hidden inline-flex items-center justify-center w-8 h-8 rounded border border-zinc-300 dark:border-zinc-700 text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors shrink-0"
          >
            <svg id="mobile-nav-icon-open" class="w-4 h-4 block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="mobile-nav-icon-close" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      {/* Mobile nav panel: collapsed by default, toggled by the button above.
          Keeps the header itself a fixed height on small viewports instead
          of letting 7 nav labels line-wrap into the header row. */}
      <nav id="mobile-nav" class="md:hidden hidden border-t border-zinc-200 dark:border-zinc-800">
        <div class="max-w-6xl mx-auto px-4 py-2 flex flex-col">
          {NAV_ITEMS.map((item) => (
            <a
              href={item.href}
              class={`py-2.5 text-sm font-mono font-medium border-b border-zinc-100 dark:border-zinc-800/70 last:border-b-0 ${active === item.key ? ACTIVE_CLASS : INACTIVE_CLASS}`}
            >
              {item.label}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <script>
      const toggle = document.getElementById('mobile-nav-toggle');
      const panel = document.getElementById('mobile-nav');
      const iconOpen = document.getElementById('mobile-nav-icon-open');
      const iconClose = document.getElementById('mobile-nav-icon-close');

      function setOpen(open: boolean) {
        panel?.classList.toggle('hidden', !open);
        toggle?.setAttribute('aria-expanded', String(open));
        iconOpen?.classList.toggle('hidden', open);
        iconClose?.classList.toggle('hidden', !open);
      }

      toggle?.addEventListener('click', () => {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });

      panel?.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).tagName === 'A') setOpen(false);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') setOpen(false);
      });

      window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
        if (e.matches) setOpen(false);
      });
    </script>

    {/* Main Content */}
    <main id="main" tabindex="-1" class={`${mainClass} focus:outline-none`}>
      <slot />
    </main>

    {/* Shared live region: copy buttons across the site (SkillCard,
        SkillExplorer) write a short message here so screen readers
        announce a successful copy, which the visual icon/text swap alone
        doesn't communicate to assistive tech. */}
    <div id="copy-announcer" role="status" aria-live="polite" class="sr-only"></div>

    {/* Footer */}
    <footer class="border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/30 mt-auto py-8">
      <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <div>
          &copy; 2026 SkillDeck Contributors. Licensed under <a href="https://github.com/kunalsuri/SkillDeck/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="hover:underline text-zinc-700 dark:text-zinc-300">Apache-2.0</a>.
        </div>
        <div class="text-center md:text-right max-w-md">
          Skill content remains under its original authors' licenses; this catalog asserts no ownership over listed skills.
        </div>
      </div>
    </footer>
  </body>
</html>
