---
import Layout from '../layouts/Layout.astro';
import SkillExplorer from '../components/SkillExplorer';
import kbData from '../data/kb.json';
import type { KB } from '../types/kb';

const title = "Software Engineering / SDLC — SkillDeck";
const description = "Coding-agent skills grouped by software development lifecycle phase: Define, Plan, Build, Verify, Review, Ship.";
---

<Layout title={title} description={description} active="sdlc" mainClass="flex-1 max-w-7xl w-full mx-auto px-4 py-16 space-y-14">
  {/* Intro Block */}
  <div class="space-y-4 text-center max-w-3xl mx-auto">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium bg-zinc-100 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 border border-zinc-200/50 dark:border-zinc-800/50 shadow-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
      Software Engineering Lifecycle Map
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight font-sans text-transparent bg-clip-text bg-gradient-to-b from-zinc-900 to-zinc-600 dark:from-white dark:to-zinc-400 pb-1">
      The Developer's Journey
    </h1>
    <p class="text-sm md:text-base text-zinc-500 dark:text-zinc-400 leading-relaxed font-sans max-w-2xl mx-auto">
      An interactive catalog of AI agent skills, mapped logically across the six core SDLC phases. Select a phase to explore targeted capabilities from definition to deployment.
    </p>
    <p class="text-[11px] font-mono text-zinc-400">
      Layout inspired by Addy Osmani's <a href="https://github.com/addyosmani/agent-skills" target="_blank" rel="noopener noreferrer" class="text-zinc-600 dark:text-zinc-300 hover:text-blue-600 dark:hover:text-blue-400 hover:underline transition-colors duration-200 font-semibold">agent-skills</a> pipeline.
    </p>
  </div>

  {/* Skill explorer: a searchable master list of every phase-classified
      skill on the left, full detail card (info grid, install options,
      try-saying prompt) for the selected one on the right. */}
  <SkillExplorer kb={kbData as unknown as KB} mode="phase" client:load />
</Layout>
