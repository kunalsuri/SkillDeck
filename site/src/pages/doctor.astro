---
import Doctor from '../components/Doctor';
import Layout from '../layouts/Layout.astro';

const title = "Skill Doctor — SkillDeck";
const description = "Paste a SKILL.md and check it against common triggering and formatting mistakes, entirely in your browser.";
---

<Layout title={title} description={description} active="doctor" mainClass="flex-1 max-w-7xl w-full mx-auto px-4 py-12 space-y-8">
  <div class="space-y-2">
    <h1 class="text-3xl md:text-4xl font-bold tracking-tight font-sans text-zinc-900 dark:text-white">
      Skill Doctor
    </h1>
    <p class="text-sm md:text-base text-zinc-500 dark:text-zinc-400 leading-relaxed font-sans max-w-2xl">
      The #1 complaint from skill authors is &ldquo;my skill never fires.&rdquo; Paste your SKILL.md below to check it against common trigger and formatting mistakes — entirely client-side, nothing leaves your browser.
    </p>
  </div>

  <Doctor client:load />
</Layout>
