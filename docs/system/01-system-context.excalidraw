      "updated": 1783454799274,
      "link": null,
      "locked": false,
      "text": "Kitchen and Site never run in the same process. The kitchen never runs in production \u2014\nVercel only installs/builds/serves site/, and data/kb.json must already be committed and up to date before a deploy.",
      "rawText": "Kitchen and Site never run in the same process. The kitchen never runs in production \u2014\nVercel only installs/builds/serves site/, and data/kb.json must already be committed and up to date before a deploy.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "Kitchen and Site never run in the same process. The kitchen never runs in production \u2014\nVercel only installs/builds/serves site/, and data/kb.json must already be committed and up to date before a deploy.",
      "lineHeight": 1.25,
      "autoResize": true
    }
