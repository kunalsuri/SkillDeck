# SkillDeck Environment Variables
# ================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env       (Linux/macOS)
#   Copy-Item .env.example .env  (PowerShell)
#
# IMPORTANT: Never commit .env — it is already in .gitignore.

# GitHub Personal Access Token (classic or fine-grained)
# Required for kitchen pipeline stages: ingest, canonicalize, freshness
# Without it, GitHub API rate-limits you to 60 requests/hour.
# Generate one at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here
